@model HomeViewModel
@{
    ViewData["Title"] = "Início";
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-content">
        <img src="~/img/avatar.png" alt="Foto de Pedro Pereira Alves" class="hero-avatar" width="140" height="140" />
        <h1 id="hero-title" class="hero-title">Pedro Alves</h1>
        <p class="hero-subtitle">Desenvolvedor Pleno .NET</p>
        <p class="hero-lead">Soluções back-end robustas com C#, APIs e arquitetura limpa.</p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="#projetos">Ver projetos</a>
            <a class="btn btn-secondary" href="#sobre">Sobre mim</a>
        </div>
    </div>
</section>

<section id="sobre" class="section" aria-labelledby="sobre-title">
    <div class="container narrow">
        <h2 id="sobre-title" class="section-title">Sobre mim</h2>
        <p class="section-text">
            Sou Pedro Pereira Alves, desenvolvedor back-end especializado em .NET e apaixonado por criar soluções robustas e escaláveis. Com 3 anos de experiência em C# e um histórico sólido em tecnologias como .NET, trabalho no desenvolvimento de aplicações web, criação de microsserviços e integração com APIs. Durante minha carreira, tive a oportunidade de otimizar sistemas e desenvolver soluções que impactaram positivamente os projetos em que participei. Sempre busco aprimorar minhas habilidades e contribuir para projetos inovadores, alinhados com as melhores práticas de desenvolvimento e arquitetura de software.
        </p>
    </div>
</section>

<section id="experiencia" class="section section-alt" aria-labelledby="exp-title">
    <div class="container narrow">
        <h2 id="exp-title" class="section-title">Experiência</h2>
        <article class="exp-item">
            <header class="exp-header">
                <h3>Engenheiro de software</h3>
                <p class="exp-meta">Domingues e Pinho Contadores · set/2022 – jul/2026</p>
            </header>
            <ul class="exp-list">
                <li>Integração com APIs governamentais e de terceiros</li>
                <li>Apps internas em C# e JavaScript</li>
                <li>Mensageria com RabbitMQ e jobs com Hangfire</li>
                <li>Trabalho em Scrum/Kanban</li>
            </ul>
        </article>
    </div>
</section>

<section id="competencias" class="section" aria-labelledby="skills-title">
    <div class="container">
        <h2 id="skills-title" class="section-title">Competências</h2>
        <ul class="skills-grid" role="list">
            @foreach (var skill in new[] { "C#", ".NET", "SQL Server", "RabbitMQ", "Hangfire", "Docker", "Git", "APIs" })
            {
                <li class="skill-badge">@skill</li>
            }
        </ul>
    </div>
</section>

<section id="projetos" class="section section-alt" aria-labelledby="proj-title">
    <div class="container">
        <h2 id="proj-title" class="section-title">Projetos</h2>
        <p class="section-lead">Repositórios com star no GitHub e projetos manuais visíveis.</p>

        @if (!string.IsNullOrWhiteSpace(Model.Erro))
        {
            <div class="state state-error" role="alert">
                <p>Não foi possível carregar os projetos.</p>
                <p class="state-detail">@Model.Erro</p>
            </div>
        }
        else if (Model.Projetos.Count == 0)
        {
            <div class="state state-empty" role="status">
                <p>Nenhum projeto visível no momento.</p>
                <p class="state-detail">A sincronização com o GitHub ou o cadastro manual vão popular esta área.</p>
            </div>
        }
        else
        {
            <div class="projects-grid">
                @foreach (var p in Model.Projetos)
                {
                    <article class="project @(p.Destaque ? "project-featured" : null)">
                        @if (p.Destaque)
                        {
                            <span class="badge-gold">Destaque</span>
                        }
                        <h3 class="project-title">@p.Nome</h3>
                        @if (!string.IsNullOrWhiteSpace(p.Descricao))
                        {
                            <p class="project-desc">@p.Descricao</p>
                        }
                        <div class="project-meta">
                            @if (!string.IsNullOrWhiteSpace(p.Linguagem))
                            {
                                <span>@p.Linguagem</span>
                            }
                            <span aria-label="@p.Stars estrelas">★ @p.Stars</span>
                        </div>
                        <div class="project-actions">
                            <a class="link" href="@p.UrlRepositorio" target="_blank" rel="noopener noreferrer">Repositório</a>
                            @if (!string.IsNullOrWhiteSpace(p.UrlDemo))
                            {
                                <a class="link" href="@p.UrlDemo" target="_blank" rel="noopener noreferrer">Demo</a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
