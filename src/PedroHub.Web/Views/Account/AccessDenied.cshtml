@{
    ViewData["Title"] = "Acesso negado";
}

<section class="auth-page">
    <div class="auth-card state-card reveal" role="alert">
        <span class="state-icon state-icon-lg" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </span>
        <h1 class="auth-title">Acesso negado</h1>
        <p class="auth-lead">Você não tem permissão para acessar este recurso.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Voltar ao início</a>
    </div>
</section>
