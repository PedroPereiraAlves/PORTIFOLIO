@{
    Layout = "_Layout";
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var projetosActive = controller == "Admin" && action is "Index" or "Criar" or "Editar";
    var monitoramentoActive = controller == "Monitoramento";
    var escritorioActive = controller == "Escritorio";
}

<div class="admin-shell">
    <aside class="admin-sidebar" aria-label="Navegação do admin">
        <p class="admin-sidebar-label">Área do Owner</p>
        <nav class="admin-sidebar-nav">
            <a class="admin-side-link @(projetosActive ? "is-active" : null)"
               asp-controller="Admin" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
                <span class="admin-side-text">Projetos</span>
            </a>
            <form asp-controller="Admin" asp-action="Sincronizar" method="post" class="admin-side-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-side-link admin-side-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
                    <span class="admin-side-text">Sincronizar</span>
                </button>
            </form>
            <a class="admin-side-link @(monitoramentoActive ? "is-active" : null)" asp-controller="Monitoramento" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                <span class="admin-side-text">Monitoramento</span>
            </a>
            <a class="admin-side-link @(escritorioActive ? "is-active" : null)" asp-controller="Escritorio" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                <span class="admin-side-text">Escritório</span>
            </a>
            <a class="admin-side-link @(action == "Cursor" ? "is-active" : null)" asp-controller="Admin" asp-action="Cursor">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span class="admin-side-text">Consumo Cursor</span>
                <span class="chip chip-muted">em breve</span>
            </a>
            <a class="admin-side-link @(action == "Gideon" ? "is-active" : null)" asp-controller="Admin" asp-action="Gideon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/><circle cx="12" cy="12" r="3"/></svg>
                <span class="admin-side-text">Gideon</span>
                <span class="chip chip-muted">em breve</span>
            </a>
        </nav>
    </aside>
    <div class="admin-content">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
