<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Pedro Alves") — Hub de Projetos</title>
    <meta name="description" content="Portfólio de Pedro Pereira Alves — Desenvolvedor .NET" />
    <meta property="og:title" content="Pedro Alves — Desenvolvedor .NET" />
    <meta property="og:description" content="Hub de Projetos — portfólio público e área do Owner." />
    <meta property="og:image" content="/img/avatar.png" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="~/img/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    <header class="site-header" id="topo">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/avatar.png" alt="Foto de Pedro Alves" class="brand-avatar" width="40" height="40" />
                <span class="brand-text">Pedro Alves</span>
            </a>

            <nav class="nav" id="siteNav" aria-label="Principal">
                <a href="/#sobre">Sobre</a>
                <a href="/#experiencia">Experiência</a>
                <a href="/#competencias">Competências</a>
                <a href="/#projetos">Projetos</a>
                <a href="/#contato">Contato</a>
                @if (User.IsInRole("Owner"))
                {
                    <a asp-controller="Admin" asp-action="Index">Admin</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="nav-logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-logout-btn">Sair</button>
                    </form>
                }
            </nav>

            <div class="header-actions">
                <button type="button" class="theme-toggle" id="themeToggle" aria-label="Alternar tema claro ou escuro" title="Alternar tema">
                    <span class="theme-toggle-icon" aria-hidden="true">
                        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"/></svg>
                    </span>
                </button>
                <a class="btn btn-primary btn-header" href="/#contato">Fale comigo</a>
                <button type="button"
                        class="nav-toggle"
                        id="navToggle"
                        aria-controls="siteNav"
                        aria-expanded="false"
                        aria-label="Abrir menu de navegação">
                    <span class="nav-toggle-bar" aria-hidden="true"></span>
                    <span class="nav-toggle-bar" aria-hidden="true"></span>
                    <span class="nav-toggle-bar" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </header>

    <main id="conteudo">
        @if (TempData["Sucesso"] is string sucesso)
        {
            <div class="container flash-wrap"><div class="alert alert-success" role="status">@sucesso</div></div>
        }
        @if (TempData["Erro"] is string erro)
        {
            <div class="container flash-wrap"><div class="alert alert-error" role="alert">@erro</div></div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer" id="contato">
        <div class="container footer-inner">
            <div class="footer-brand">
                <img src="~/img/avatar.png" alt="" class="footer-avatar" width="48" height="48" />
                <div>
                    <p class="footer-name">Pedro Pereira Alves</p>
                    <p class="footer-tag">Desenvolvedor .NET</p>
                </div>
            </div>
            <div class="footer-links">
                <a href="https://github.com/PedroPereiraAlves" rel="noopener noreferrer" target="_blank">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.16 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>
                    GitHub
                </a>
                <a href="https://www.linkedin.com/in/pedro-pereira-3b2a7519b" rel="noopener noreferrer" target="_blank">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1-.004-4.123 2.062 2.062 0 0 1 .004 4.123zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    LinkedIn
                </a>
                <a href="mailto:pedro05vr@gmail.com">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/></svg>
                    E-mail
                </a>
            </div>
            <p class="footer-copy">&copy; @DateTime.UtcNow.Year Pedro Pereira Alves</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
