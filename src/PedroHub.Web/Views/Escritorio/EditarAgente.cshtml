@model AgenteEscritorioFormViewModel
@{
    ViewData["Title"] = "Editar agente";
    Layout = "_AdminLayout";
}

<div class="admin-page admin-page-narrow">
    <header class="admin-page-header">
        <div>
            <h1 class="section-title">Editar agente</h1>
            <p class="section-lead">Slug <code>@Model.Slug</code> é estável e não pode mudar.</p>
        </div>
    </header>

    <form method="post" class="admin-form" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Slug" />
        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

        <div class="field">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" class="input" />
            <span asp-validation-for="Nome" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Papel"></label>
            <input asp-for="Papel" class="input" />
            <span asp-validation-for="Papel" class="field-error"></span>
        </div>
        <div class="field-row">
            <div class="field">
                <label asp-for="Sala"></label>
                <select asp-for="Sala" class="input" asp-items="Html.GetEnumSelectList<PedroHub.Domain.Enums.SalaEscritorio>()"></select>
            </div>
            <div class="field">
                <label asp-for="Ordem"></label>
                <input asp-for="Ordem" class="input" type="number" min="0" max="999" />
            </div>
        </div>
        <div class="field field-inline">
            <input asp-for="Ativo" />
            <label asp-for="Ativo"></label>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg">Salvar</button>
            <a class="btn btn-ghost" asp-action="Agentes">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
