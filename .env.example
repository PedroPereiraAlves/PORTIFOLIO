# Obrigatórias — copie para .env e preencha (nunca commite o .env)
HUB_OWNER_EMAIL=seu-email@exemplo.com
HUB_OWNER_PASSWORD=defina-uma-senha-forte
HUB_GITHUB_TOKEN=ghp_seu_token_aqui

# Postgres (Compose e/ou connection string local)
POSTGRES_DB=pedrohung
POSTGRES_USER=pedrohung
POSTGRES_PASSWORD=defina-senha-do-postgres

# Usado pelo `dotnet run` / `dotnet ef` fora do Compose
ConnectionStrings__Default=Host=localhost;Port=5432;Database=pedrohung;Username=pedrohung;Password=defina-senha-do-postgres

# Opcional — alertas do monitoramento (Resend)
# Resend__ApiKey=
# Monitoramento__Alertas__De=alertas@seudominio.com
# Monitoramento__Alertas__Para=voce@email.com

# Opcional — prints Playwright (docs/pr-screenshots/capture.mjs)
# HUB_CAPTURE_EMAIL=
# HUB_CAPTURE_PASSWORD=

# Opcional — consumo Cursor. A Admin API (Enterprise) usa Basic auth.
# Sem a chave, a tela segue só com importação do CSV do dashboard.
# HUB_CURSOR_API_KEY=
# CursorConsumo__CotaTokens=50000000
# CursorConsumo__CotaUsd=20
# CursorConsumo__DiaInicioCiclo=1

# Opcional — ingestão do Escritório (Gideon → Hub). Valor fake só para dev local.
# HUB_GIDEON_API_KEY=chave-fake-dev
# Escritorio__RetencaoDias=90
# Escritorio__MinutosDesatualizado=30
# Escritorio__PollingSegundos=20
