<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Pedro Alves") — Hub de Projetos</title>
    <meta name="description" content="Portfólio de Pedro Pereira Alves — Desenvolvedor Pleno .NET" />
    <meta property="og:title" content="Pedro Alves — Desenvolvedor Pleno .NET" />
    <meta property="og:description" content="Hub de Projetos — portfólio público e área do Owner." />
    <meta property="og:image" content="/img/avatar.png" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/avatar.png" alt="" class="brand-avatar" width="40" height="40" />
                <span class="brand-text">Pedro Alves</span>
            </a>
            <nav class="nav" aria-label="Principal">
                <a href="#sobre">Sobre</a>
                <a href="#experiencia">Experiência</a>
                <a href="#competencias">Competências</a>
                <a href="#projetos">Projetos</a>
                @if (User.IsInRole("Owner"))
                {
                    <a asp-controller="Admin" asp-action="Index">Admin</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Entrar</a>
                }
            </nav>
            <button type="button" class="theme-toggle" id="themeToggle" aria-label="Alternar tema claro ou escuro">
                Tema
            </button>
        </div>
    </header>

    <main id="conteudo">
        @if (TempData["Sucesso"] is string sucesso)
        {
            <div class="container"><div class="alert alert-success" role="status">@sucesso</div></div>
        }
        @if (TempData["Erro"] is string erro)
        {
            <div class="container"><div class="alert alert-error" role="alert">@erro</div></div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p>&copy; @DateTime.UtcNow.Year Pedro Pereira Alves</p>
            <div class="footer-links">
                <a href="https://github.com/PedroPereiraAlves" rel="noopener noreferrer" target="_blank">GitHub</a>
                <a href="https://www.linkedin.com/in/pedro-pereira-3b2a7519b" rel="noopener noreferrer" target="_blank">LinkedIn</a>
            </div>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
