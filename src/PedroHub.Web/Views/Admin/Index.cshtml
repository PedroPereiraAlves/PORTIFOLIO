@model IReadOnlyList<ProjetoDto>
@{
    ViewData["Title"] = "Admin — Projetos";
}

<section class="section admin-section">
    <div class="container">
        <div class="admin-header">
            <div>
                <h1 class="section-title">Projetos</h1>
                <p class="section-lead">Gerencie visibilidade, destaque, ordem e demos.</p>
            </div>
            <div class="admin-actions">
                <a class="btn btn-secondary" asp-action="Criar">Novo projeto</a>
                <form asp-action="Sincronizar" method="post" class="inline-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Sincronizar agora</button>
                </form>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost">Sair</button>
                </form>
            </div>
        </div>

        <nav class="admin-nav" aria-label="Módulos admin">
            <a class="admin-nav-active" asp-action="Index">Projetos</a>
            <a asp-action="Saude">Saúde <span class="chip">em breve</span></a>
            <a asp-action="Cursor">Consumo Cursor <span class="chip">em breve</span></a>
            <a asp-action="Gideon">Gideon <span class="chip">em breve</span></a>
        </nav>

        @if (Model.Count == 0)
        {
            <div class="state state-empty" role="status">
                <p>Nenhum projeto cadastrado.</p>
                <p class="state-detail">Use “Sincronizar agora” ou cadastre um projeto manualmente.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Stars</th>
                            <th>Origem</th>
                            <th>Ordem</th>
                            <th>Flags</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <strong>@p.Nome</strong>
                                <div class="muted truncate">@p.UrlRepositorio</div>
                            </td>
                            <td>@p.Stars</td>
                            <td>@p.Origem</td>
                            <td>@p.Ordem</td>
                            <td>
                                <span class="chip @(p.Visivel ? "chip-ok" : "chip-off")">@(p.Visivel ? "visível" : "oculto")</span>
                                @if (p.Destaque)
                                {
                                    <span class="chip chip-gold">destaque</span>
                                }
                            </td>
                            <td class="actions-cell">
                                <a class="link" asp-action="Editar" asp-route-id="@p.Id">Editar</a>
                                <form asp-action="AlternarVisibilidade" asp-route-id="@p.Id" method="post" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="link-btn">@(p.Visivel ? "Ocultar" : "Mostrar")</button>
                                </form>
                                <form asp-action="AlternarDestaque" asp-route-id="@p.Id" method="post" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="link-btn">@(p.Destaque ? "Remover destaque" : "Destacar")</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
