@{
    ViewData["Title"] = "Escritório";
    Layout = "_AdminLayout";
}

<div class="admin-page escritorio-page">
    <header class="admin-page-header">
        <div>
            <h1 class="section-title">Escritório</h1>
            <p class="section-lead">Mapa dos agentes do Gideon. Estado no servidor; o front só desenha.</p>
        </div>
        <div class="admin-actions">
            <a class="btn btn-ghost" asp-action="Agentes">Editar elenco</a>
            <button type="button" class="btn btn-ghost" id="escritorioToggleMapLista" aria-pressed="true">
                <span data-mode-label>Lista</span>
            </button>
            <button type="button" class="btn btn-ghost" id="escritorioCenter">Centralizar</button>
        </div>
    </header>

    <p id="escritorioA11yHelp" class="visually-hidden">
        Mapa do escritório. Tab e Shift+Tab selecionam agentes sem abrir o painel. Enter abre. Esc fecha.
        Mais e menos ajustam o zoom. Setas fazem pan. No último agente, Tab sai do mapa.
    </p>
    <p id="escritorioSelecaoLive" class="visually-hidden" aria-live="polite"></p>
    <p id="escritorioLoadWarn" class="alert alert-error" hidden>
        Não foi possível carregar o mapa; use a lista.
    </p>

    <div class="escritorio-layout">
        <div class="escritorio-map-pane" id="escritorioMapPane">
            <div class="escritorio-canvas-wrap">
                <div id="escritorio-game"
                     class="escritorio-canvas"
                     role="application"
                     tabindex="0"
                     aria-label="Mapa do escritório em pixel art"
                     aria-describedby="escritorioA11yHelp"></div>
                <div id="escritorioNameTags" class="escritorio-nametags" aria-hidden="true"></div>
                <div id="escritorioRoomLabels" class="escritorio-room-labels" aria-hidden="true"></div>
                <aside class="escritorio-panel" id="escritorioPanel" hidden>
                    <div class="escritorio-panel-head">
                        <h2 class="escritorio-panel-title" id="escritorioPanelTitle">Agente</h2>
                        <button type="button" class="btn btn-sm btn-ghost" id="escritorioPanelClose" aria-label="Fechar painel">Fechar</button>
                    </div>
                    <canvas id="escritorioPanelPortrait" class="escritorio-portrait" width="64" height="64" hidden></canvas>
                    <p class="escritorio-panel-papel muted" id="escritorioPanelPapel"></p>
                    <dl class="escritorio-panel-meta">
                        <div><dt>Status</dt><dd><span id="escritorioPanelStatus" class="escritorio-status-chip">—</span></dd></div>
                        <div><dt>Projeto</dt><dd id="escritorioPanelProjeto">—</dd></div>
                        <div><dt>Atualizado</dt><dd id="escritorioPanelQuando">—</dd></div>
                    </dl>
                    <p class="escritorio-panel-tarefa" id="escritorioPanelTarefa"></p>
                    <p><a id="escritorioPanelPr" class="btn btn-sm btn-primary" href="#" target="_blank" rel="noopener noreferrer" hidden>Abrir PR</a></p>
                    <h3 class="escritorio-panel-sub">Últimas entregas</h3>
                    <ul class="escritorio-entregas" id="escritorioPanelEntregas"></ul>
                </aside>
            </div>
        </div>
    </div>

    <section class="escritorio-lista" id="escritorioLista" aria-labelledby="escritorio-lista-title">
        <h2 id="escritorio-lista-title" class="section-title">Visão em lista</h2>
        <p class="muted" id="escritorioListaLive" aria-live="polite" aria-atomic="true"></p>
        <div class="table-wrap admin-table-desktop">
            <table class="table" id="escritorioTabela">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Sala</th>
                        <th>Status</th>
                        <th>Tarefa</th>
                        <th>Atualizado</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="admin-cards" id="escritorioCards" role="list"></div>
    </section>
</div>

@section Scripts {
    @* Desktop: carrega Phaser no primeiro paint. Mobile lista: boot.js injeta sob demanda. *@
    <script src="~/js/escritorio/agents.js" asp-append-version="true" defer></script>
    <script src="~/js/escritorio/ui-panel.js" asp-append-version="true" defer></script>
    <script src="~/js/escritorio/boot.js" asp-append-version="true" defer></script>
}
