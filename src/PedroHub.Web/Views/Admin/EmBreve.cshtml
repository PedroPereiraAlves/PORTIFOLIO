@model string
@{
    ViewData["Title"] = $"{Model} — em breve";
    Layout = "_AdminLayout";
}

<div class="admin-page">
    <div class="state state-empty state-card reveal" role="status">
        <span class="state-icon state-icon-lg" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
            </svg>
        </span>
        <h1 class="auth-title">@Model</h1>
        <p class="auth-lead">Este módulo chega em uma fase futura do Hub.</p>
        <a class="btn btn-primary" asp-action="Index">Voltar aos projetos</a>
    </div>
</div>
