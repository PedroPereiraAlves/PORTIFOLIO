{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Monitoramento": {
    "RetencaoDias": 30,
    "FalhasParaOffline": 2,
    "ConcorrenciaMaxima": 4,
    "PortasPermitidas": [ 80, 443 ],
    "Alertas": {
      "MinutosEntreEmailsPorAlvo": 10,
      "MaxEmailsPorHora": 20
    }
  },
  "Resend": {
  },
  "AllowedHosts": "*"
}
