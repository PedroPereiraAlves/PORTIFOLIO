@model ProjetoFormViewModel
@{
    ViewData["Title"] = Model.EhEdicao ? "Editar projeto" : "Novo projeto";
    Layout = "_AdminLayout";
}

<div class="admin-page admin-page-narrow">
    <header class="admin-page-header">
        <div>
            <h1 class="section-title">@(Model.EhEdicao ? "Editar projeto" : "Novo projeto")</h1>
            <p class="section-lead">
                @(Model.EhEdicao
                    ? "Atualize descrição, demo, ordem e flags. Nome e URL do repositório vêm do cadastro."
                    : "Cadastre um projeto manual. A validação de URLs e permissões é feita no servidor.")
            </p>
        </div>
    </header>

    <form method="post" class="admin-form" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

        @if (Model.EhEdicao)
        {
            <div class="field">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="input" readonly />
                <p class="field-help">Nome sincronizado ou cadastrado — somente leitura.</p>
            </div>
            <div class="field">
                <label asp-for="UrlRepositorio"></label>
                <input asp-for="UrlRepositorio" class="input" readonly />
            </div>
        }
        else
        {
            <div class="field">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="input" placeholder="Ex.: Hub de Projetos" />
                <span asp-validation-for="Nome" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="UrlRepositorio"></label>
                <input asp-for="UrlRepositorio" class="input" placeholder="https://github.com/..." />
                <span asp-validation-for="UrlRepositorio" class="field-error"></span>
                <p class="field-help">URL pública do repositório (https).</p>
            </div>
            <div class="field">
                <label asp-for="Linguagem"></label>
                <input asp-for="Linguagem" class="input" placeholder="C#" />
            </div>
        }

        <div class="field">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao" class="input" rows="4" placeholder="Resumo curto do projeto"></textarea>
            <p class="field-help">Aparece no card público (até ~3 linhas).</p>
        </div>

        <div class="field">
            <label asp-for="UrlDemo"></label>
            <input asp-for="UrlDemo" class="input" placeholder="https://..." />
            <span asp-validation-for="UrlDemo" class="field-error"></span>
            <p class="field-help">Opcional. Se preenchida, o botão Demo aparece no portfólio.</p>
        </div>

        <div class="field">
            <label asp-for="Ordem"></label>
            <input asp-for="Ordem" class="input" type="number" min="0" />
            <p class="field-help">Menor número aparece primeiro (após os destaques).</p>
        </div>

        <div class="field-row">
            <div class="field field-inline">
                <input asp-for="Visivel" />
                <label asp-for="Visivel"></label>
            </div>
            <div class="field field-inline">
                <input asp-for="Destaque" />
                <label asp-for="Destaque"></label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg">Salvar</button>
            <a class="btn btn-ghost" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
