@{
    Layout = "_Layout";
}

<div class="admin-shell">
    <aside class="admin-sidebar" aria-label="Navegação do admin">
        <p class="admin-sidebar-label">Área do Owner</p>
        <nav class="admin-sidebar-nav">
            <a class="admin-side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" || ViewContext.RouteData.Values["action"]?.ToString() == "Criar" || ViewContext.RouteData.Values["action"]?.ToString() == "Editar" ? "is-active" : null)"
               asp-controller="Admin" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
                Projetos
            </a>
            <form asp-controller="Admin" asp-action="Sincronizar" method="post" class="admin-side-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-side-link admin-side-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
                    Sincronizar
                </button>
            </form>
            <a class="admin-side-link" asp-controller="Admin" asp-action="Saude">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                Monitoramento
                <span class="chip chip-muted">em breve</span>
            </a>
            <a class="admin-side-link" asp-controller="Admin" asp-action="Cursor">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                Configurações
                <span class="chip chip-muted">em breve</span>
            </a>
        </nav>
        <form asp-controller="Account" asp-action="Logout" method="post" class="admin-logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-ghost btn-block">Sair</button>
        </form>
    </aside>
    <div class="admin-content">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
